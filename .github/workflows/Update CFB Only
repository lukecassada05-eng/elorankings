name: Update CFB Only

on:
  workflow_dispatch:
  push:
    paths:
      - 'R/update_cfb.R'
      - 'R/elo_engine.R'

env:
  FORCE_JAVASCRIPT_ACTIONS_TO_NODE24: true

permissions:
  contents: write

jobs:
  cfb:
    name: "College Football (ESPN API)"
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4.2.2

      - name: System deps
        run: |
          sudo apt-get update -qq
          sudo apt-get install -y --no-install-recommends \
            libcurl4-openssl-dev libssl-dev libxml2-dev \
            libstdc++6 build-essential r-base-dev

      - uses: r-lib/actions/setup-r@v2.11.3
        with: { r-version: 'latest' }

      - uses: actions/cache@v4.2.3
        with:
          path: ${{ env.R_LIBS_USER }}
          key: r-cfb-${{ runner.os }}-latest-v6
          restore-keys: r-cfb-${{ runner.os }}-

      - name: Install R packages
        run: |
          Rscript -e "
            install.packages('pak', repos='https://cloud.r-project.org', quiet=TRUE)
            pak::pak(c('dplyr','readr','httr','jsonlite'))
            stopifnot(requireNamespace('httr', quietly=TRUE))
            message('packages OK')
          "

      - name: Run CFB update
        run: Rscript R/update_cfb.R

      - name: Commit and push
        run: |
          git config user.name  "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add docs/CFB/
          git diff --staged --quiet || git commit -m "data(cfb): $(date -u '+%Y-%m-%d %H:%M UTC')"
          git push
